# ─────────────────────────────────────────────────────────────
# Library Management SaaS — Admin Application (.env.example)
# Target: admin.mydomain.com / http://localhost:5174
# ─────────────────────────────────────────────────────────────

# Central Backend API URL (leave empty in local dev to use Vite proxy /api)
VITE_API_URL=http://localhost:5000/api
# In production:
# VITE_API_URL=https://api.mydomain.com/api

# Public / Main Application URL (for redirecting non-admins or returning to main site)
VITE_PUBLIC_URL=http://localhost:5173
# In production:
# VITE_PUBLIC_URL=https://mydomain.com
